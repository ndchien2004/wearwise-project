# === MẪU SECRET — sao chép file này thành application-secrets.properties rồi điền key thật ===
# File application-secrets.properties đã được gitignore nên sẽ KHÔNG bị commit.
# Ngoài cách này, bạn cũng có thể đặt các biến môi trường tương ứng
# (CLOUDINARY_API_KEY, TRYON_API_KEY, GEMINI_API_KEY, ...).

# Cloudinary — lấy tại Dashboard > Product Environment Credentials
wearwise.cloudinary.cloud-name=your-cloud-name
wearwise.cloudinary.api-key=your-cloudinary-api-key
wearwise.cloudinary.api-secret=your-cloudinary-api-secret

# tryon-api.com — lấy tại https://tryon-api.com
wearwise.tryon.api-key=tryon_xxxxxxxxxxxxxxxx

# Google Gemini — lấy tại https://aistudio.google.com/apikey
wearwise.gemini.api-key=AIza-your-gemini-key
wearwise.gemini.model=gemini-2.5-flash
